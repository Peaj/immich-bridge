{
  "manifest_version": 3,
  "name": "Immich Bridge",
  "version": "0.4.1",
  "description": "Adds Immich Bridge local workstation actions to Immich asset detail pages.",
  "homepage_url": "https://github.com/Peaj/immich-bridge",
  "minimum_chrome_version": "102",
  "permissions": [
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Immich Bridge",
    "default_icon": {
      "32": "icons/immich-bridge-32.png",
      "64": "icons/immich-bridge-64.png",
      "128": "icons/immich-bridge-128.png"
    }
  },
  "icons": {
    "32": "icons/immich-bridge-32.png",
    "64": "icons/immich-bridge-64.png",
    "128": "icons/immich-bridge-128.png"
  }
}
