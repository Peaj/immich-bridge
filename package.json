{
  "private": true,
  "scripts": {
    "check:userscript": "node --check userscript/immich-bridge.user.js",
    "check:extension": "node --check browser-extension/background.js && node --check browser-extension/content/immich-bridge-content.js && node --check browser-extension/options/options.js",
