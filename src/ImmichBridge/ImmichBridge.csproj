<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>immich-bridge.ico</ApplicationIcon>
    <Version>0.4.1</Version>
    <AssemblyVersion>0.4.1.0</AssemblyVersion>
    <FileVersion>0.4.1.0</FileVersion>
    <Product>Immich Bridge</Product>
    <Description>Windows helper for Immich workstation actions.</Description>
    <Authors>Immich Bridge Contributors</Authors>
    <RepositoryUrl>https://github.com/Peaj/immich-bridge</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Peaj/immich-bridge</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so setup keeps its artwork when the exe runs on its own from the install folder. -->
    <EmbeddedResource Include="..\..\browser-extension\store-badges\*.png" LogicalName="ImmichBridge.Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\browser-extension\icons\immich-bridge-promo-title.png" LogicalName="ImmichBridge.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
